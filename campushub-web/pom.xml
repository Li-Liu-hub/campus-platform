<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.campushub</groupId>
        <artifactId>campushub</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>campushub-web</artifactId>
    <name>campushub-web</name>
    <dependencies>
        <dependency>
            <groupId>com.campushub</groupId>
            <artifactId>campushub-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campushub</groupId>
            <artifactId>campushub-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campushub</groupId>
            <artifactId>campushub-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campushub</groupId>
            <artifactId>campushub-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campushub</groupId>
            <artifactId>campushub-post</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campushub</groupId>
            <artifactId>campushub-order</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campushub</groupId>
            <artifactId>campushub-shop</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campushub</groupId>
            <artifactId>campushub-message</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campushub</groupId>
            <artifactId>campushub-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <!-- 接口文档（OpenAPI 3）：/v3/api-docs 供 Apifox 等工具导入，/swagger-ui 自带可视化 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
