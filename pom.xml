<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.campushub</groupId>
    <artifactId>campushub</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CampusHub</name>
    <description>CampusHub modular web application</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
        <sa-token.version>1.44.0</sa-token.version>
        <redisson.version>4.7.0</redisson.version>
    </properties>

    <modules>
        <module>campushub-common</module>
        <module>campushub-infrastructure</module>
        <module>campushub-system</module>
        <module>campushub-user</module>
        <module>campushub-admin</module>
        <module>campushub-post</module>
        <module>campushub-order</module>
        <module>campushub-shop</module>
        <module>campushub-message</module>
        <module>campushub-notification</module>
        <module>campushub-web</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.campushub</groupId>
                <artifactId>campushub-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campushub</groupId>
                <artifactId>campushub-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campushub</groupId>
                <artifactId>campushub-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campushub</groupId>
                <artifactId>campushub-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campushub</groupId>
                <artifactId>campushub-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campushub</groupId>
                <artifactId>campushub-post</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campushub</groupId>
                <artifactId>campushub-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campushub</groupId>
                <artifactId>campushub-shop</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campushub</groupId>
                <artifactId>campushub-message</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campushub</groupId>
                <artifactId>campushub-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-template</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
